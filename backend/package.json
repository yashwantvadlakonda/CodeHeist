{
  "name": "codeheist-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shared Express + Socket.IO API server for CodeHeist Game and CodeHeist Admin",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "bootstrap-admin": "node src/scripts/bootstrapAdmin.js",
    "db:check": "node src/db/checkConnection.js",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.3",
    "socket.io": "^4.8.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
