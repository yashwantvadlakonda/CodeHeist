# CodeHeist Root Environment Example (refer to app-specific .env.example files)
# Backend: CodeHeist/backend/.env.example
# Game Frontend: CodeHeist/game/frontend/.env.example
# Admin Frontend: CodeHeist/admin/frontend/.env.example
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/codeheist
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
GAME_ORIGIN=https://game.example.com
ADMIN_ORIGIN=https://admin.example.com
ADMIN_EMAIL=admin@example.com
